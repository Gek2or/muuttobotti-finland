{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muuttobotti-finland",
  "keep_vars": true,
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "dist/client"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "muuttobotti-db",
      "database_id": "89027a74-62e9-4f73-9fec-11daf0c6d0c3"
    }
  ]
}

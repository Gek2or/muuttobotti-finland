{
  "expo": {
    "name": "Muuttobotti",
    "slug": "muuttobotti",
    "version": "2.3.0",
    "orientation": "portrait",
    "scheme": "muuttobotti",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Muuttobotti",
      "shortName": "Muuttobotti"
    },
    "experiments": {
      "baseUrl": "/app-preview"
    },
    "androidStatusBar": {
      "backgroundColor": "#06191F",
      "barStyle": "light-content",
      "translucent": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Muuttobotti tarvitsee pääsyn kuviin, jotta voit liittää kuvia varaukseen.",
          "cameraPermission": "Muuttobotti tarvitsee kameran käyttöoikeuden, jotta voit kuvata muutettavat tavarat.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fi.muuttobotti.app",
      "buildNumber": "25",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "fi.muuttobotti.app",
      "versionCode": 25,
      "adaptiveIcon": { "backgroundColor": "#06191F" },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [{ "scheme": "muuttobotti", "host": "track" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "extra": { "apiBaseUrl": "https://muuttobotti.fi", "releaseChannel": "v2.3" }
  }
}

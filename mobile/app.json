{
  "expo": {
    "name": "Muuttobotti",
    "slug": "muuttobotti",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "muuttobotti",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "backgroundColor": "#071B22",
      "barStyle": "light-content",
      "translucent": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Muuttobotti tarvitsee pääsyn kuviin, jotta voit liittää kuvia varaukseen.",
          "cameraPermission": "Muuttobotti tarvitsee kameran käyttöoikeuden, jotta voit kuvata muutettavat tavarat.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fi.muuttobotti.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "fi.muuttobotti.app",
      "versionCode": 1,
      "adaptiveIcon": { "backgroundColor": "#071B22" },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [{ "scheme": "muuttobotti", "host": "track" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "extra": { "apiBaseUrl": "https://muuttobotti.fi" }
  }
}
